@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
	@if (!_isShow) return;

	<div class="bottom">💖 @_player.Health</div>
	<div class="bottom">🧬 @_player.Dna</div>
</root>

@code
{
	[Property] private Player _player;

    private bool _isShow = true;

	protected override int BuildHash() => System.HashCode.Combine(_player.Dna, _player.Health, _isShow);

	protected override void OnStart()
	{
		if (_player is null)
			_player = GetComponent<Player>();
	}

	public void Show() => _isShow = true;
	public void Hide() => _isShow = false;
}